variable "aws_region" {
  type    = string
  default = "ap-south-1"
}
variable "project" {
  type    = string
  default = "reelnest"
}
variable "environment" {

  type    = string
  default = "staging"
  validation {

    condition     = contains(["staging", "production"], var.environment)
    error_message = "Use staging or production; unknown modes must not skip production security checks."

  }
}
variable "vpc_cidr" {
  type    = string
  default = "10.42.0.0/16"
}
variable "zone_id" {
  type        = string
  description = "Existing Route53 public hosted zone ID"
}
variable "root_domain" {
  type        = string
  description = "Example: example.com, must be controlled by operator"
}
variable "alb_certificate_arn" {
  type        = string
  description = "Existing valid ACM cert in deployment region for app/api hosts"
}
variable "cdn_certificate_arn" {
  type        = string
  description = "Existing valid ACM cert in us-east-1 for stream host"
}
variable "cdn_public_key_pem" {
  type        = string
  description = "PEM of public key ONLY; do NOT put CDN signing private key in Terraform"
}
variable "api_image" {
  type        = string
  description = "Immutable published API ECR image URL incl SHA/digest"
}
variable "web_image" {
  type        = string
  description = "Immutable prebuilt Next.js production image with public URLs baked at build"
}
variable "worker_image" {
  type        = string
  description = "Immutable published worker ECR image URL"
}
variable "identity_issuer_url" {
  type        = string
  description = "Existing HTTPS OIDC issuer; deployed separately"
}
variable "identity_jwks_uri" {
  type        = string
  description = "Public JWKS endpoint for issuer"
}
variable "key_pair_id" {
  type        = string
  description = "CloudFront trusted public key ID, generated by Terraform from public key"
  default     = ""
}
variable "enable_services" {
  type        = bool
  default     = false
  description = "False until external OIDC, CI images and database migrations are verified"
}

# One-country launch model: the API uses a server-configured territory and
# CloudFront rejects viewer countries outside the same country.
# This is an edge filter, NOT an IP spoof-proof location attestation.
variable "playback_country" {

  type    = string
  default = "IN"
  validation {

    condition     = can(regex("^[A-Z]{2}$", var.playback_country))
    error_message = "Use a two-letter uppercase ISO country code."

  }
}
variable "reviewed_geo_enforcement" {

  type        = bool
  default     = false
  description = "Operator attestation only after verifying CloudFront geofence and bypass tests. False keeps CDN session issuing disabled."
}
