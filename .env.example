# Development configuration. Do NOT put secrets in Git.
# Compose provides local demo values; override Razorpay TEST only in private .env.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STANDARD_PLAN_ID=
RAZORPAY_PREMIUM_PLAN_ID=
RECOMMENDER_INTERNAL_TOKEN=local-only-change-before-staging
# Production: generate secrets in AWS Secrets Manager, never in files or images.
JWT_REQUIRED_AUDIENCE=reelnest-api
JWT_REQUIRED_CLIENT=reelnest-web
